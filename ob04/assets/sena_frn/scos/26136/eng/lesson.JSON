\u00e9nerv\u00e9</span> ?", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Quelque chose ne va pas. Essayez encore une fois !", "type": "text"}, {"content": "La prochaine fois peut-\u00eatre.", "type": "text"}], "correct_feedback": "Parfait !", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"content": [{"content": " \u201c<span class = \"italic\">\u00e9nerv\u00e9</span>\u201d : ne pas \u00eatre content. ", "tip_id": 0, "type": "text"}], "type": "tips"}, {"contents": [{"content": "Appuyez sur le bouton pour \u00e9couter l'enregistrement audio. ", "type": "text"}], "type": "post_instructions"}], "id": 1, "stimuli_ids": [1]}, {"template_override": 1, "questions": [{"_data": [{"contents": [{"content": "cin\u00e9ma", "type": "text"}], "type": "question"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "frn2le06ob04re3aud01", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "", "type": "rec"}], "type": "question"}], "id": 1, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "s'asseoir", "type": "text"}], "type": "question"}], "id": 2, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "frn2le06ob04re3aud02", "type": "text"}], "selected": 0}]}, {"_data": [{"contents": [{"content": "", "type": "rec"}], "type": "question"}], "id": 3, "responses": [{"correc